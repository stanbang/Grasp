{
  "name": "@grasp/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i src/tailwind.css -o src/tailwind.generated.css --minify",
    "dev": "npm run css && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run css && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.7",
    "lucide-react": "^0.468.0",
    "react-force-graph-3d": "1.29.2",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "tailwindcss": "3.4.19"
  }
}
