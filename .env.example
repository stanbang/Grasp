MOCK_LLM=1
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
GOOGLE_API_KEY=
# For Gemini, set LLM_PROVIDER=gemini, LLM_MODEL=gemini-3.1-flash-lite,
# and EMBEDDING_MODEL=gemini-embedding-001.
DATA_DIR=data
MAX_NODES_PER_DOCUMENT=40
CONCEPT_SIMILARITY_THRESHOLD=0.90
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MAX_UPLOAD_BYTES=10485760
API_PORT=8000
WEB_PORT=5173
# Optional public API documentation URL for a hosted frontend build.
VITE_API_REFERENCE_URL=
# Optional owner token for self-hosting. Keep empty only for private local use.
ACCESS_TOKEN=
REQUESTS_PER_MINUTE=120
# Local scanned-PDF OCR; native tools must be installed before enabling.
OCR_ENABLED=0
OCR_LANGUAGE=eng
