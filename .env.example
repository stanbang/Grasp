MOCK_LLM=1
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
GOOGLE_API_KEY=
# For Gemini, set LLM_PROVIDER=gemini, LLM_MODEL=gemini-2.5-flash,
# and EMBEDDING_MODEL=gemini-embedding-001.
DATA_DIR=data
MAX_NODES_PER_DOCUMENT=40
CONCEPT_SIMILARITY_THRESHOLD=0.90
API_PORT=8000
WEB_PORT=5173
# Optional public API documentation URL for a hosted frontend build.
VITE_API_REFERENCE_URL=
